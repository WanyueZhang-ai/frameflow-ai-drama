# Personal-server mode only. Browser BYO API keys stay in the tab's memory.
# Demo mode requires no configuration. Never commit real keys.
HOST=127.0.0.1
PORT=8787

# OpenAI-compatible Chat Completions endpoint; model must support JSON mode.
# For a reference image, the configured model must also support vision.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Speech-compatible endpoint. Choose an available model from your provider.
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy

# Project-defined video adapter protocol: docs/PROVIDERS.md
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_POLL_MS=3000
VIDEO_TIMEOUT_MS=600000

# Install FFmpeg separately or set an absolute executable path.
FFMPEG_PATH=ffmpeg

# Optional exact comma-separated web origins. Use local UI by default.
ALLOWED_ORIGINS=
